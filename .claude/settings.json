{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:worker)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm build)",
      "Bash(pnpm check)",
      "Bash(pnpm check:*)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter * test:worker)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * lint)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(rg *)"
    ],
    "deny": [
      "Bash(pnpm deploy*)",
      "Bash(pnpm run deploy*)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler secret*)",
      "Bash(*--remote*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(mv *.dev.vars*)",
      "Bash(rm *.dev.vars*)",
      "Bash(mv *.env.production*)",
      "Bash(rm *.env.production*)",
      "Read(**/.dev.vars)",
      "Read(**/.env)",
      "Read(**/.env.production)",
      "Edit(**/.dev.vars)",
      "Edit(**/.env)",
      "Edit(**/.env.production)"
    ]
  }
}
