{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shaxda-db-test",
  "main": "src/test-worker.ts",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shaxda-db-test",
      "database_id": "local-test-database",
    },
  ],
}
