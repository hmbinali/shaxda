{
  "name": "@shaxda/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./match-fixtures": {
      "types": "./src/match-fixtures.ts",
      "default": "./src/match-fixtures.ts"
    },
    "./rated-play": {
      "types": "./src/rated-play.ts",
      "default": "./src/rated-play.ts"
    },
    "./identity": {
      "types": "./src/identity/ticket.ts",
      "default": "./src/identity/ticket.ts"
    },
    "./analytics/events": {
      "types": "./src/analytics/events.ts",
      "default": "./src/analytics/events.ts"
    },
    "./analytics/hash": {
      "types": "./src/analytics/hash.ts",
      "default": "./src/analytics/hash.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shaxda/game-engine": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
