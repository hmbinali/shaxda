# Copy to .dev.vars for local auth development. Never commit real values.
AUTH_BASE_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# Must exactly match worker/.dev.vars ONLINE_IDENTITY_SECRET.
ONLINE_IDENTITY_SECRET=replace-with-the-same-random-online-identity-secret
