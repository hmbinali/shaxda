# Public build values for `pnpm test:e2e`, tracked on purpose.
#
# Loaded by `vite build --mode e2e`, and passed to Wrangler as
# `platformProxy.envFiles` so a developer's own `web/.dev.vars` is ignored for
# the duration of an end-to-end run. `.env.production`, `.env` and `.env.local`
# stay untracked and have no effect on E2E.
#
# Public, non-sensitive fixture values only. Never put a secret in this file:
# the E2E auth fixtures live in `web/wrangler.e2e.jsonc`.
PUBLIC_SITE_ORIGIN=http://127.0.0.1:4173
PUBLIC_WORKER_ORIGIN=http://127.0.0.1:8787
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_CF_BEACON_TOKEN=
