{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [
        ".svelte-kit/output/**",
        ".svelte-kit/cloudflare/**",
        ".svelte-kit/cloudflare-tmp/**"
      ],
      "env": [
        "PUBLIC_SITE_ORIGIN",
        "PUBLIC_WORKER_ORIGIN",
        "PUBLIC_TURNSTILE_SITE_KEY",
        "PUBLIC_CF_BEACON_TOKEN",
        "SHAXDA_REQUIRE_PUBLIC_ENV",
        "SHAXDA_KIT_OUT_DIR",
        "SHAXDA_WRANGLER_CONFIG",
        "SHAXDA_WRANGLER_ENV_FILES",
        "SHAXDA_WRANGLER_PERSIST"
      ]
    },
    "typecheck": {
      "outputs": [
        ".svelte-kit/ambient.d.ts",
        ".svelte-kit/env.d.ts",
        ".svelte-kit/generated/**",
        ".svelte-kit/non-ambient.d.ts",
        ".svelte-kit/tsconfig.json",
        ".svelte-kit/types/**"
      ],
      "env": ["SHAXDA_KIT_OUT_DIR"]
    }
  }
}
