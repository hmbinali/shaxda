{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shaxda-web",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "workers_dev": false,
  "vars": {
    "AUTH_BASE_URL": "https://shaxda.app",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shaxda-db",
      "database_id": "b84cc232-ddbd-437d-acd0-0fa0d77e12b0",
      "migrations_dir": "../packages/db/migrations",
      "migrations_table": "d1_migrations",
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "routes": [
    {
      "pattern": "shaxda.app/*",
      "zone_name": "shaxda.app",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
