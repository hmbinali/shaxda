{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must never match the production Worker name in wrangler.jsonc: a preview
  // deploy under that name would replace the live shaxda.app script.
  "name": "shaxda-web-preview",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "workers_dev": true,
  "vars": {
    "AUTH_BASE_URL": "https://shaxda-web-preview.shaxda.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shaxda-db-preview",
      "database_id": "5a84ac83-8387-4b68-b831-28ec450cd922",
      "migrations_dir": "../packages/db/migrations",
      "migrations_table": "d1_migrations",
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "observability": {
    "enabled": true,
  },
}
