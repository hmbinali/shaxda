# Game Worker values for `pnpm test:e2e`, tracked on purpose.
#
# Passed to `wrangler dev --env-file`, which is what makes Wrangler ignore a
# developer's own `worker/.dev.vars` for the duration of an end-to-end run.
# Without it, a local `ALLOWED_ORIGIN` and a real `TURNSTILE_SECRET` leak into
# the run and every online room creation fails with `turnstileFailed`.
#
# Public, non-sensitive fixture values only. Never put a secret in this file.
# `ONLINE_IDENTITY_SECRET` is deliberately left to `worker/wrangler.toml` so the
# dev/test value stays declared in exactly one place.
ALLOWED_ORIGIN=http://127.0.0.1:4173
# Empty on purpose: the Worker skips Turnstile verification when unset.
TURNSTILE_SECRET=
